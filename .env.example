# ==============================================================================
# Archivo de ejemplo de configuración de variables de entorno (.env.example)
#
# Para usarlo:
#   1. Copia este archivo como '.env':
#      cp .env.example .env
#   2. Asigna tus credenciales de las APIs si deseas obtener datos reales.
#   3. Si no tienes claves o dejas DEMO_MODE=1, el sistema corre offline
#      en modo DEMO con datos simulados realistas.
# ==============================================================================

# Clave de API para el servicio de vuelos AirLabs (https://airlabs.co/)
AIRLABS_API_KEY=

# Clave de API para el servicio meteorológico OpenWeather (https://openweathermap.org/)
OPENWEATHER_API_KEY=

# Motor de cálculo numérico: 'numba' (compilado JIT multinúcleo) o 'numpy' (estándar)
BACKEND=numba

# Modo de ejecución: 1 / true = simulación sintética sin peticiones de red; 0 = APIs reales
DEMO_MODE=

# Códigos IATA de los aeropuertos a monitorear separados por comas
AIRPORTS=CUU,MEX,GDL,MTY,TIJ

# Ruta al archivo de almacenamiento SQLite
DB_PATH=data/trafico.db
