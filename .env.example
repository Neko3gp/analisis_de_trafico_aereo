# Copia este archivo como .env y pega tus claves.
# Sin claves (o con DEMO_MODE=1) el proyecto corre con datos simulados.

AIRLABS_API_KEY=
OPENWEATHER_API_KEY=

# numba (por defecto) | mlx (GPU del chip Apple, opcional) | cupy (solo Colab) | numpy
BACKEND=numba

# 1 = datos simulados aunque haya claves
DEMO_MODE=

# Aeropuertos IATA separados por coma
AIRPORTS=CUU,MEX,GDL,MTY,TIJ

DB_PATH=data/trafico.db
